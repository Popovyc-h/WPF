<Window x:Class="FileDuplicateChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileDuplicateChecker"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <StackPanel Margin="5">

        <TextBlock Text="Шлях до директорії джерела" VerticalAlignment="Center" Margin="0,0,5,0"></TextBlock>
        <TextBox AcceptsReturn="True" TextWrapping="Wrap" 
             Height="70" x:Name="SourceTextBox" Margin="0,10,0,0"/>

        <TextBlock Text="Шлях до директорії приймача" VerticalAlignment="Center" Margin="0,0,5,0"></TextBlock>
        <TextBox AcceptsReturn="True" TextWrapping="Wrap" 
             Height="70" x:Name="ReceiverTextBox" Margin="0,10,0,0"/>

        <Button x:Name="StartButton" Click="StartButton_Click" Content="Start" Margin="0,5,0,0"></Button>

        <ScrollViewer Height="150">
            <TextBlock Height="40" x:Name="ResultTextBlock" Margin="0,10,0,0"/>
        </ScrollViewer>
        
    </StackPanel>
    
</Window>
